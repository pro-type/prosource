generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Lead {
  id            String         @id @default(cuid())
  company       String
  contactPerson String
  email         String
  phone         String?
  country       String?
  serviceNeed   String?
  notes         String?
  source        String?        @default("manual")
  status        String         @default("new")
  isArchived    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  campaign      EmailCampaign?
  replies       EmailReply[]

  @@index([status])
  @@index([isArchived])
  @@index([email])
}

model EmailCampaign {
  id                 String    @id @default(cuid())
  leadId             String    @unique
  lead               Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status             String    @default("active")
  currentStep        Int       @default(1)
  introEmailSentAt   DateTime?
  followup1SentAt    DateTime?
  followup2SentAt    DateTime?
  followup3SentAt    DateTime?
  responseReceivedAt DateTime?
  nextFollowupDue    DateTime?
  gmailThreadId      String?
  gmailMessageId     String?
  templateId         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([nextFollowupDue])
}

model EmailReply {
  id             String    @id @default(cuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  gmailMessageId String?
  direction      String
  fromEmail      String
  fromName       String?
  subject        String
  body           String    @db.Text
  bodyHtml       String?   @db.Text
  receivedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([leadId])
  @@index([gmailMessageId])
}

model EmailTemplate {
  id               String   @id @default(cuid())
  name             String
  isDefault        Boolean  @default(false)
  introSubject     String
  introBody        String   @db.Text
  followup1Subject String
  followup1Body    String   @db.Text
  followup2Subject String
  followup2Body    String   @db.Text
  followup3Subject String
  followup3Body    String   @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Signature {
  id        String   @id @default(cuid())
  name      String
  role      String?
  tagline   String?
  links     Json     @default("[]")
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}
